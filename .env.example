# Postgres connection string. On Supabase: Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Supabase endpoints use the bundled public Supabase CA with certificate/hostname verification.
# Other remote production DB connections verify against Node's trusted CA store. If your provider
# uses a private CA, supply its CA file with NODE_EXTRA_CA_CERTS; do not disable verification.

# Claude API key for the AI tester (worker only). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Public URL of the web app, used in Stripe redirects and report emails.
APP_URL=http://localhost:3000
# Set the exact public HTTPS origin in production. Form actions require an exact Origin match.
# Confirmed production origin: https://testshift.musme.co

# Future Stripe support is disabled during the manual Wise beta. A key alone does not enable it.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, for "your report is ready" emails. Optional in dev.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Dev only: how many real minutes one booked hour lasts. Use 2 to try a full shift quickly.
SHIFT_MINUTES_PER_HOUR=60

# Owner-only dashboard at /admin (Claude token usage, cost, margin, quote requests).
# Use a long random password; the dashboard is off while this is empty.
ADMIN_PASSWORD=

# Where new custom pricing requests are emailed (needs RESEND_API_KEY and EMAIL_FROM too).
OWNER_EMAIL=

# Maximum free trials across all customers per 24 hours (caps what trials can cost you).
MAX_TRIALS_PER_DAY=100

# Bounded connections per web/worker process (1-20). Total = processes x this value.
DATABASE_POOL_SIZE=5
# Estimated model spend per free shift, across all plans.
QA_MAX_TRIAL_USD=2
# Estimated model budget as a fraction of paid shift revenue (0 < value <= 1).
QA_AI_REVENUE_FRACTION=0.1
# Self-hosted web only: set 1 ONLY behind a proxy that overwrites forwarded IP headers
# and prevents direct origin access. Vercel is detected automatically. Default shares
# one rate-limit bucket rather than trusting user-supplied IP headers.
TRUST_PROXY_HEADERS=0

# GitHub App (all server-only). See docs/GITHUB_TESTING.md for registration and activation.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM private key with literal \n escapes or a quoted multiline value.
GITHUB_APP_PRIVATE_KEY=
# Random secret of at least 32 characters. Same value in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=
# A separate random 32-byte key encoded as base64; encrypts short-lived user access tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Owner-funded repository generation pilot: enable only after reviewed migration and App permission upgrade.
# Set on both Vercel and the GitHub worker. Worker also needs ANTHROPIC_API_KEY.
# Fixed limits: 3 requests/customer/24h, 10/day globally, one bounded model call/request.
GITHUB_GENERATION_ENABLED=0

# Extra browser engines for the cross-browser check, comma-separated: firefox, webkit. Off by default.
# Before enabling one on the worker machine, run `npm run check:engines` there and confirm it passes.
QA_ENGINES=chromium
