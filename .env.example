# Postgres connection string. On Supabase: Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Claude API key for the AI tester (worker only). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Public URL of the web app, used in Stripe redirects and report emails.
APP_URL=http://localhost:3000

# Stripe (test keys start with sk_test_). Leave empty in local dev to skip payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, for "your report is ready" emails. Optional in dev.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Dev only: how many real minutes one booked hour lasts. Use 2 to try a full shift quickly.
SHIFT_MINUTES_PER_HOUR=60

# Owner-only dashboard at /admin (Claude token usage, cost, margin, quote requests).
# Use a long random password; the dashboard is off while this is empty.
ADMIN_PASSWORD=

# Where new custom pricing requests are emailed (needs RESEND_API_KEY and EMAIL_FROM too).
OWNER_EMAIL=

# Maximum free trials across all customers per 24 hours (caps what trials can cost you).
MAX_TRIALS_PER_DAY=100

# Bounded connections per web/worker process (1-20). Total = processes x this value.
DATABASE_POOL_SIZE=5
# Estimated model spend per free shift, across all plans.
QA_MAX_TRIAL_USD=2
# Estimated model budget as a fraction of paid shift revenue (0 < value <= 1).
QA_AI_REVENUE_FRACTION=0.25
# Self-hosted web only: set 1 ONLY behind a proxy that overwrites forwarded IP headers
# and prevents direct origin access. Vercel is detected automatically. Default shares
# one rate-limit bucket rather than trusting user-supplied IP headers.
TRUST_PROXY_HEADERS=0
