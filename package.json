{
  "name": "testshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
