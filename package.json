{
  "name": "testshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "node --import tsx scripts/selfcheck.ts",
    "test": "node --import tsx --test tests/*.test.ts && node --test github-action/runner.test.mjs",
    "test:e2e": "playwright test",
    "security:scan": "node --import tsx scripts/security-scan.ts",
    "github:worker": "node --env-file-if-exists=.env.local --import tsx scripts/github-worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "axe-core": "4.13.0",
    "next": "16.3.8",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.2",
    "three": "0.186.1",
    "tldts": "7.4.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
